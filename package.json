{
  "name": "cachemesh",
  "version": "0.1.0",
  "private": true,
  "description": "CacheMesh - Universal Caching SDK & Multi-Level Cache Engine",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node examples/quickstart/dist/index.js",
    "demo": "npm run build && node examples/quickstart/dist/index.js",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
